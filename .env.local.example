# .env.local — NÃO commitar no git (já está no .gitignore)
# Copie este arquivo para .env.local e preencha com os valores reais

# Supabase Auth
# Encontrar em: Supabase Dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# Supabase Anon Key (chave pública — vai para o cliente)
# Encontrar em: Supabase Dashboard → Project Settings → Data API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# Prisma — conexão runtime via PgBouncer (porta 6543, transaction pooler)
# Encontrar em: Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler
# IMPORTANTE: adicionar ?pgbouncer=true&connection_limit=1 ao final da string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma — conexão direta (porta 5432, apenas para migrations e prisma db push)
# Encontrar em: Supabase Dashboard → Project Settings → Database → Connection string → Direct connection
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# UUID do usuário criado no Supabase Auth (usado APENAS pelo seed.ts — não vai para Vercel)
# Encontrar em: Supabase Dashboard → Authentication → Users → selecionar o usuário → copiar o UUID
SEED_USER_ID=[supabase-auth-uuid]

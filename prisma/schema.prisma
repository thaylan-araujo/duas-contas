// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EmpresaTipo {
  AFILIADO
  JURIDICO_SERVICOS
  INFOPRODUTO
  GENERICO
}

enum CategoryKind {
  RECEITA
  CUSTO
}

enum TransactionType {
  ENTRADA
  SAIDA
}

model User {
  id              String           @id
  categories      Category[]
  transactions    Transaction[]
  empresas        Empresa[]
  monthlyBudgets  MonthlyBudget[]
  categoryBudgets CategoryBudget[]
  fixedAccounts   FixedAccount[]
  annualExpenses  AnnualExpense[]
  goals           Goal[]
  createdAt       DateTime         @default(now())
}

// Empresa (D-02/D-03/D-07). Cada empresa tem suas próprias categorias e
// lançamentos. Casa é representada por empresaId NULL em Category/Transaction
// (não há linha Empresa para a Casa). onDelete: Restrict protege contra
// exclusão em cascata (D-08) — a exclusão é bloqueada no service se houver
// lançamentos vinculados.
model Empresa {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  nome         String
  tipo         EmpresaTipo
  cor          String // chave da paleta fixa (UI-SPEC §Color)
  categories   Category[]
  // Relação de CONTA: lançamentos que PERTENCEM a esta empresa (empresaId).
  transactions Transaction[] @relation("ContaEmpresa")
  // Lado inverso da relação "OrigemEmpresa": lançamentos de pró-labore cuja
  // empresa DE ONDE o dinheiro saiu é esta empresa (04c-01/D-04). Distinto de
  // `transactions` acima (a conta à qual o lançamento pertence).
  transacoesOrigem Transaction[] @relation("OrigemEmpresa")
  // Alíquota percentual do DAS (Simples Nacional) desta empresa — ex.: 6,00 ou
  // 15,50 (04d-01/CONS-02/D-03). Decimal (não Int) porque é um percentual, não
  // dinheiro: a convenção de centavos Int dos valores monetários permanece
  // intocada; só a alíquota é Decimal. NULL = alíquota ainda não definida,
  // estado legítimo e distinto de 0% → DAS estimado = 0 / "não definido" (D-03).
  aliquotaDasPercent Decimal? @db.Decimal(5, 2)
  createdAt    DateTime      @default(now())

  @@unique([nome, userId])
}

model Category {
  id              String           @id @default(cuid())
  name            String
  empresa         Empresa?         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empresaId       String? // null = Casa
  kind            CategoryKind? // null para Casa; RECEITA/CUSTO para empresa
  user            User             @relation(fields: [userId], references: [id])
  userId          String
  transactions    Transaction[]
  categoryBudgets CategoryBudget[]
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())

  // NOTA: o @@unique abaixo NÃO cobre a Casa (empresaId null) sozinho — o índice
  // real é criado com NULLS NOT DISTINCT no SQL hand-editado (04-RESEARCH Pitfall 1).
  @@unique([name, empresaId, userId])
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  description String
  amountCents Int
  type        TransactionType
  category    Category        @relation(fields: [categoryId], references: [id])
  categoryId  String
  // Relação de CONTA: a empresa à qual o lançamento pertence (null = Casa).
  empresa     Empresa?        @relation("ContaEmpresa", fields: [empresaId], references: [id], onDelete: Restrict)
  empresaId   String? // null = Casa
  // Empresa DE ONDE o pró-labore saiu (04c-01/D-04). Marca a ORIGEM tanto na
  // SAÍDA da empresa quanto na ENTRADA da Casa, permitindo agrupar a renda
  // familiar por origem com um groupBy direto (04c-03). NULL para lançamentos
  // comuns que não são pró-labore marcado (ex.: "outras entradas" como salário).
  origemEmpresa   Empresa? @relation("OrigemEmpresa", fields: [origemEmpresaId], references: [id], onDelete: Restrict)
  origemEmpresaId String? // null = não é pró-labore marcado
  user        User            @relation(fields: [userId], references: [id])
  userId      String
  origin      String          @default("manual")
  pairId      String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([origemEmpresaId])
}

model MonthlyBudget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  month        String
  ceilingCents Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, month])
}

// Teto mensal OPCIONAL por categoria da Casa (D-03/CASA-R-02). Guardado por
// (userId, mês, categoria): uma categoria tem no máximo um teto por mês.
// A ausência de linha significa "sem teto" (mostra só o gasto). É referência,
// nunca bloqueia lançamento.
model CategoryBudget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  month      String // 'YYYY-MM'
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limitCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, month, categoryId])
}

// Conta fixa (FIXA-01). Entra automaticamente no plano do mês no grupo
// "Contas fixas" como linha derivada em tempo de render (D-05) — não é
// persistida como PlanItem.
model FixedAccount {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  dueDay      Int // 1..31
  amountCents Int
  autoDebit   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Gasto anual (FIXA-02). Exibe apenas "guardar por mês" = yearlyCents / 12
// (D-05); não vira meta automaticamente.
model AnnualExpense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  yearlyCents Int
  dueMonth    Int // 1..12
  createdAt   DateTime @default(now())
}

// Meta de poupança (META-01/META-02). Seed nasce apenas com o nome:
// alvo/guardado zerados, prazo nulo para o usuário preencher (D-06).
model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  targetCents Int      @default(0)
  savedCents  Int      @default(0)
  deadline    String? // 'YYYY-MM' nullable (seed sem prazo)
  createdAt   DateTime @default(now())
}
